# ─────────────────────────────────────────────────────────────────────────────
# ST7071CEM — Information Retrieval Assignment
# Environment Variable Template (env.example)
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Connection string to your MongoDB Atlas cluster.
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/?retryWrites=true
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_PORT=5000
FLASK_DEBUG=True

# ── Task 2: RSS Feed URLs ─────────────────────────────────────────────────────
# Replace the placeholder values below with real RSS feed URLs before running
# the RSS collector.  The system reads these from the environment, so you never
# need to modify rss_collector.py — only this file.

# Economics RSS Feed
ECONOMICS_RSS_URL="http://feeds.bbci.co.uk/news/business/rss.xml"

# Entertainment RSS Feed
ENTERTAINMENT_RSS_URL="http://feeds.bbci.co.uk/news/entertainment_and_arts/rss.xml"

# Politics RSS Feed
POLITICS_RSS_URL="http://feeds.bbci.co.uk/news/politics/rss.xml"

# --- Task 1: Crawler Schedule ---
CRAWL_INTERVAL_MONTHS=3

# Optional: if set, POST /api/crawler/run requires this value in the
# X-Admin-Key header. Leave unset in local development.
CRAWLER_ADMIN_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Example BBC RSS feeds (publicly available):
#   Economics:      https://feeds.bbci.co.uk/news/business/rss.xml
#   Entertainment:  https://feeds.bbci.co.uk/news/entertainment_and_arts/rss.xml
#   Politics:       https://feeds.bbci.co.uk/news/politics/rss.xml
# ─────────────────────────────────────────────────────────────────────────────
